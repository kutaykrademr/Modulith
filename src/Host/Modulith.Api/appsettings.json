{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "_comment": "Secret ASLA repoda saklanmaz. Dev: 'dotnet user-secrets set \"Jwt:Secret\" <deger>'. Prod: Jwt__Secret environment variable. En az 32 karakter olmali.",
    "Secret": "",
    "Issuer": "Modulith.Api",
    "Audience": "Modulith.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "ConnectionStrings": {
    "_comment": "Dev/docker varsayilani. Prod'da ConnectionStrings__ModulithDb environment variable ile ezilmelidir.",
    "ModulithDb": "Host=localhost;Port=5432;Database=modulith_db;Username=modulith;Password=modulith_pass"
  },
  "Cors": {
    "_comment": "Izin verilen origin'ler. Bos birakilirsa CORS politikasi uygulanmaz (sadece ayni-origin).",
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "Fixed": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Register": { "PermitLimit": 3, "WindowSeconds": 60 }
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SenderEmail": "noreply@modulith.dev",
    "SenderName": "Modulith",
    "EnableSsl": false,
    "Username": "",
    "Password": ""
  },
  "App": {
    "BaseUrl": "http://localhost:5116"
  }
}
